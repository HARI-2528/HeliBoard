<?xml version="1.0" encoding="utf-8"?>
<!-- Custom layout for AI input dialog (Rephrase tone / What to write) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_input_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/ai_input_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:gravity="center_vertical"
        android:inputType="textCapSentences|textNoSuggestions"
        android:singleLine="true"
        android:maxLines="1"
        android:imeOptions="actionGo"
        android:background="@drawable/ai_input_background"
        android:textColor="#1D1D1F"
        android:textColorHint="#7D7D7D"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:importantForAccessibility="yes" />

</LinearLayout>